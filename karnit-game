    const enemyHpPct = (enemy.hp / enemy.maxHp) * 100;

    let warning = '';
    if (realmDiff >= 3) {
        warning = '<p class="crimson-text" style="text-align:center;font-weight:bold;">警告：敌人境界远高于你！灵魂压制生效！</p>';
    } else if (realmDiff >= 2) {
        warning = '<p class="crimson-text" style="text-align:center;">敌人高你两个大境界，攻击可能无效化！</p>';
    } else if (realmDiff >= 1) {
        warning = '<p style="text-align:center;color:var(--accent-bronze);">敌人高你一个大境界，位阶压制生效。</p>';
    }

    const html = `
        <div class="parchment">
            <div class="title-block">
                <h1>战斗遭遇</h1>
                <div class="subtitle">${char.location || char.region} · 回合 ${combat.round + 1}</div>
            </div>
            ${warning}
            <div class="combat-arena">
