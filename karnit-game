                    <div class="combatant">
                        <div class="combatant-name">${char.name}</div>
                        <div class="hp-bar">
                            <div class="hp-fill ${playerHpPct < 30 ? 'danger' : playerHpPct < 60 ? 'warning' : ''}" style="width:${playerHpPct}%"></div>
                            <div class="hp-text">${combat.playerHp}/${combat.playerMaxHp}</div>
                        </div>
                        <div style="font-size:0.8em;color:var(--ink-light);margin-top:5px;">
                            ${DATA.realms[char.realm].name} Lv.${char.level} · ${char.class}
                        </div>
                    </div>
                    <div class="vs-mark">VS</div>
                    <div class="combatant">
                        <div class="combatant-name">${enemy.name}</div>
                        <div class="hp-bar">
                            <div class="hp-fill ${enemyHpPct < 30 ? 'danger' : enemyHpPct < 60 ? 'warning' : ''}" style="width:${enemyHpPct}%"></div>
                            <div class="hp-text">${enemy.hp}/${enemy.maxHp}</div>
                        </div>
                        <div style="font-size:0.8em;color:var(--ink-light);margin-top:5px;">
                            ${DATA.realms[enemy.realm].name} Lv.${enemy.level} · ${enemy.class}
                        </div>
                    </div>
                </div>
                ${combat.log.length > 0 ? `<div class="combat-log">${combat.log[combat.log.length - 1]}</div>` : ''}
