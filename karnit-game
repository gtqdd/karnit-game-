function generateKarmaDesc(type) {
    const descs = {
        '当地势力': '你被某个地下帮派标记，或被一位贵族暗中庇护。',
        '未来导师/仇敌': '一位耀辉境强者感应到了你的天赋，或影刃组织接到了关于你的委托。',
        '物品/地点': '你的襁褓中藏着一枚神秘符文石，或家乡地下埋着上古遗迹入口。',
        '神界注视': '某位神境以上的存在，透过命运丝线看到了你的轮廓。',
        '碎片共鸣': '你曾接触过碎片持有者，体内残留着微弱的共鸣痕迹。'
    };
    return descs[type] || '未知的因果纠缠。';
}

function weightedPick(arr, weightKey) {
    if (!Array.isArray(arr)) {
        const keys = Object.keys(arr);
        return arr[keys[Math.floor(Math.random() * keys.length)]];
    }
    if (!weightKey) return arr[Math.floor(Math.random() * arr.length)];
    const total = arr.reduce((sum, item) => sum + (item[weightKey] || 1), 0);
    let roll = Math.random() * total;
    for (const item of arr) {
        roll -= (item[weightKey] || 1);
        if (roll <= 0) return item;
    }
    return arr[0];
}

// ==================== 渲染引擎 ====================

function renderScreen(content) {
    const root = document.getElementById('gameRoot');
    root.innerHTML = '';
    if (typeof content === 'string') {
        root.innerHTML = content;
    } else if (content instanceof HTMLElement) {
        root.appendChild(content);
    }
    const children = root.children;
    for (let i = 0; i < children.length; i++) {
        children[i].classList.add('fade-in');
        children[i].style.animationDelay = `${i * 0.1}s`;
    }
}

function createParchment(content, cert) {
    const div = document.createElement('div');
    div.className = 'parchment';
    if (cert) {
        const certDiv = document.createElement('div');
        certDiv.className = 'cert-num';
        certDiv.textContent = cert;
        div.appendChild(certDiv);
    }
    if (typeof content === 'string') {
        div.innerHTML += content;
    } else {
        div.appendChild(content);
    }
    return div;
}

function showModal(title, body, actions) {
    const overlay = document.getElementById('modalOverlay');
    const content = document.getElementById('modalContent');
    let html = `<div class="modal-title">${title}</div>`;
    html += `<div class="modal-body">${body}</div>`;
    if (actions && actions.length > 0) {
        html += '<div class="modal-actions">';
        actions.forEach(action => {
            html += `<button class="btn ${action.class || ''}" onclick="${action.onclick}">${action.text}</button>`;
        });
        html += '</div>';
    }
    content.innerHTML = html;
    overlay.classList.add('active');
}

function closeModal() {
    document.getElementById('modalOverlay').classList.remove('active');
}

function addLog(text, type) {
    const entry = {
        time: `纪元${GameState.world.year}年·${GameState.world.season}`,
        text: text,
        type: type || 'normal'
    };
    GameState.log.push(entry);
    if (GameState.log.length > 100) GameState.log.shift();
}

