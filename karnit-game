function selectConfig(key, value, el) {
    GameState.config[key] = value;
    const parent = el.parentElement;
    parent.querySelectorAll('.config-option').forEach(opt => opt.classList.remove('selected'));
    el.classList.add('selected');
    el.querySelector('input').checked = true;
}

function startGame() {
    GameState.config.name = document.getElementById('charName').value.trim();
    GameState.config.gender = document.getElementById('charGender').value;
    GameState.config.race = document.getElementById('charRace').value;

    GameState.character = generateBirth();
    GameState.phase = 'birth';
    GameState.turn = 0;
    GameState.log = [];

    addLog(`源核公证：${GameState.character.name}于星耀纪元第${GameState.world.year}万年在${GameState.character.continent}·${GameState.character.region}诞生。`, 'event');

