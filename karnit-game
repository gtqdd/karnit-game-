function doCultivation() {
    const char = GameState.character;
    const realm = DATA.realms[char.realm];

    if (char.realm === 0) {
        // 尝试踏入炼脉
        const success = KARNIT.roll(100) <= (95 + char.breakBonus);
        if (success) {
            char.realm = 1;
            char.level = 1;
            char.realmBonus += 50;
            char.stats.MND += 1;
            char.stats.CON += 1;
            addLog('成功凝聚第一条能量通道，踏入炼脉境！寿元增加50年。', 'break');
            showModal('突破成功', `
                <p>你盘坐于${char.region}的一处灵脉节点之上，感受着体内第一条能量通道的成形。</p>
                <p class="quote">魔力如涓涓细流，在经脉中缓缓流淌。你终于踏入了超凡的门槛。</p>
            `, [{ text: '继续', onclick: 'closeModal();showYouth()', class: 'btn' }]);
        } else {
            char.accumulation += 10;
            addLog('冥想感悟，积累增加，但尚未触及炼脉门槛。', 'normal');
            showModal('修炼感悟', `
                <p>你尝试感应天地间的魔力，但经脉如同堵塞的河道，魔力只能在局部流转。</p>
                <p class="quote">积累深度：${char.accumulation}%</p>
            `, [{ text: '继续', onclick: 'closeModal();showYouth()', class: 'btn' }]);
        }
    } else {
        // 正常修炼
        const gain = KARNIT.rollRange(5, 15) * (char.cultivationSpeed / 100);
        char.accumulation += gain;

        // 感悟
        if (KARNIT.roll(100) <= char.stats.MND * 3) {
            char.insight += KARNIT.rollRange(1, 5);
        }

        // 肉身承载
        if (KARNIT.roll(100) <= char.stats.CON * 3) {
            char.vessel += KARNIT.rollRange(1, 3);
        }

        addLog(`修炼结束。积累+${gain.toFixed(1)}%，当前积累${char.accumulation.toFixed(1)}%。`, 'normal');
        showModal('修炼结束', `
            <p>你在${char.region}的灵脉旁冥想了一季。</p>
            <p>积累深度：${char.accumulation.toFixed(1)}%</p>
            <p>法则感悟：${char.insight}</p>
            <p>肉身承载：${char.vessel}</p>
        `, [{ text: '继续', onclick: 'closeModal();showYouth()', class: 'btn' }]);
    }
}

function doBreakthrough() {
    const char = GameState.character;
    const currentRealm = DATA.realms[char.realm];
    const nextRealm = DATA.realms[char.realm + 1];

    if (!nextRealm) {
        showModal('已达巅峰', '<p>你已站在当前道路的尽头，前方已无明确的路标。</p>', [{ text: '返回', onclick: 'closeModal()', class: 'btn-secondary' }]);
        return;
    }

    // 检查条件
    const checks = [];
    if (char.accumulation < 100) checks.push('积累不足');
    if (char.insight < char.realm * 10) checks.push('感悟不足');
    if (char.vessel < char.realm * 8) checks.push('承载不足');
    if (char.mindstate < 30) checks.push('心境不稳');

    if (checks.length > 0) {
        showModal('突破准备', `
            <p>你感受到境界壁垒的存在，但以下隐患阻碍着你：</p>
            <ul>${checks.map(c => `<li>${c}</li>`).join('')}</ul>
            <p class="quote">强行突破将大幅降低成功率，并可能遭受严重反噬。</p>
        `, [
            { text: '强行突破', onclick: 'closeModal();attemptBreakthrough(true)', class: 'btn-danger' },
            { text: '继续准备', onclick: 'closeModal()', class: 'btn-secondary' }
        ]);
    } else {
        showModal('突破准备', `
            <p>你的积累已满溢，法则感悟清晰，肉身与心境都已准备就绪。</p>
            <p class="quote">突破${nextRealm.name}境的基础成功率：${nextRealm.breakRate}%</p>
        `, [
            { text: '开始突破', onclick: 'closeModal();attemptBreakthrough(false)', class: 'btn' },
            { text: '再等等', onclick: 'closeModal()', class: 'btn-secondary' }
        ]);
    }
}

function attemptBreakthrough(forced) {
    const char = GameState.character;
    const nextRealm = DATA.realms[char.realm + 1];
    if (!nextRealm) return;

    let successRate = nextRealm.breakRate + char.breakBonus;
    if (forced) successRate = Math.floor(successRate / 2);

    const roll = KARNIT.roll(100);
    const success = roll <= successRate;

    if (success) {
        char.realm += 1;
        char.level = 1;
        char.realmBonus += nextRealm.lifeBonus;
        char.accumulation = 0;
        char.insight += KARNIT.rollRange(5, 15);
        char.vessel += KARNIT.rollRange(3, 10);
        char.mindstate += KARNIT.rollRange(5, 10);

        // 属性提升
        const stats = ['VIG','PER','MND','CHA','CON','LUC'];
        const boost = KARNIT.pick(stats);
        char.stats[boost] += 1;

        addLog(`突破成功！踏入${nextRealm.name}境！${nextRealm.mark}`, 'break');

        let desc = `<p>魔力如决堤洪水般冲击着境界壁垒，在一阵剧痛与狂喜交织中，你感到某种桎梏被打破。</p>`;
        if (roll <= 5) {
            desc += `<p class="quote">完美突破！额外领悟了${char.talentElement}法则的深层奥秘。</p>`;
            char.cultivationSpeed += 10;
        }
        desc += `<p>寿元增加${nextRealm.lifeBonus}年，当前总寿元：${char.baseLifespan + char.realmBonus}年。</p>`;

        showModal('突破成功', desc, [{ text: '继续', onclick: 'closeModal();showYouth()', class: 'btn' }]);
    } else {
        const loss = forced ? KARNIT.rollRange(30, 50) : KARNIT.rollRange(10, 30);
        char.accumulation -= loss;
        if (char.accumulation < 0) char.accumulation = 0;

        let desc = `<p>魔力在冲击壁垒时反噬，经脉剧痛，一口鲜血喷出。</p>`;

        if (roll > successRate + 30) {
            char.healthStatus = '经脉损伤';
            desc += `<p class="quote">严重失败！经脉受损，修炼速度下降，需史诗级药材修复。</p>`;
            char.cultivationSpeed -= 10;
        } else {
            desc += `<p>突破中止，积累损失${loss}%。</p>`;
        }

        addLog(`突破失败！积累损失${loss}%。${char.healthStatus === '经脉损伤' ? '经脉受损！' : ''}`, 'combat');
        showModal('突破失败', desc, [{ text: '继续', onclick: 'closeModal();showYouth()', class: 'btn' }]);
    }
}

