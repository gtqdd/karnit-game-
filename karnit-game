        worldMark: 0,

        karma: { blood: [], grace: [], item: [], fate: [] },

        legend: 0,
        achievements: [],

        location: '出生点',
        currentGoal: '生存',
        focusNPCs: []
    };

    // 步骤1：大陆与地域
    const cont = weightedPick(DATA.continents, 'weight');
    char.continent = cont.name;
    char.region = weightedPick(cont.regions, 'weight').name;

    // 步骤2：家庭阶层
    const familyRoll = KARNIT.roll(1000);
    if (familyRoll <= 80) char.familyClass = '赤贫';
    else if (familyRoll <= 700) char.familyClass = '平民';
    else if (familyRoll <= 900) char.familyClass = '中产';
    else if (familyRoll <= 980) char.familyClass = '富裕';
    else if (familyRoll <= 999) {
        char.familyClass = '贵族';
        if (KARNIT.roll(100) <= 60) char.family.nobleType = '世袭贵族';
        else char.family.nobleType = '高阶超凡者家庭';
    } else {
        char.familyClass = '超凡世家';
        char.realmBonus += 100;
        char.mindDemon += 5;
    }

    // 步骤3：种族与天赋
    const raceData = DATA.races[char.race];
    const talentRoll = KARNIT.roll(100);
    let tierIdx = 1;

    if (char.race === '人类') {
        if (talentRoll <= 40) tierIdx = 0;
        else if (talentRoll <= 70) tierIdx = 1;
        else if (talentRoll <= 85) tierIdx = 2;
        else if (talentRoll <= 95) tierIdx = 3;
        else if (talentRoll <= 99) tierIdx = 4;
        else tierIdx = KARNIT.roll(2) === 1 ? 9 : 0;
    } else if (char.race === '精灵') {
        if (talentRoll <= 30) tierIdx = 2;
        else if (talentRoll <= 60) tierIdx = 3;
        else if (talentRoll <= 80) tierIdx = 4;
        else if (talentRoll <= 95) tierIdx = 5;
        else if (talentRoll <= 99) tierIdx = 6;
        else tierIdx = 9;
    } else if (char.race === '矮人' || char.race === '兽人' || char.race === '死灵族') {
        if (talentRoll <= 30) tierIdx = 0;
        else if (talentRoll <= 70) tierIdx = 2;
        else if (talentRoll <= 90) tierIdx = 3;
        else if (talentRoll <= 98) tierIdx = 4;
        else tierIdx = 9;
    } else if (char.race === '元素族') {
        if (talentRoll <= 20) tierIdx = 3;
        else if (talentRoll <= 60) tierIdx = 4;
        else if (talentRoll <= 85) tierIdx = 5;
        else if (talentRoll <= 98) tierIdx = 6;
        else tierIdx = 9;
    } else if (char.race === '巨龙族' || char.race === '泰坦族') {
        if (talentRoll <= 20) tierIdx = 4;
        else if (talentRoll <= 60) tierIdx = 5;
        else if (talentRoll <= 85) tierIdx = 6;
        else if (talentRoll <= 98) tierIdx = 7;
        else tierIdx = 8;
    }

    char.talentTier = DATA.talentTiers[tierIdx] || '下品';
    char.talentElement = KARNIT.pick(DATA.elements);

    // 步骤4：源核碎片
    if (GameState.config.mode === 'FRAGMENT_VESSEL') {
        if (KARNIT.roll(20) === 20) {
            char.fragment = true;
            char.fragmentLevel = 1;
            char.hunger = 20;
        }
    } else if (GameState.config.mode === 'FATE_WOVEN') {
        if (KARNIT.roll(100) === 100) {
            char.fragment = true;
            char.fragmentLevel = 1;
            char.hunger = 20;
        }
    }

    // 步骤5：因果锚定
    for (let i = 0; i < 3; i++) {
        const karmaRoll = KARNIT.roll(100);
        let type = '';
        if (karmaRoll <= 30) type = '当地势力';
        else if (karmaRoll <= 55) type = '未来导师/仇敌';
        else if (karmaRoll <= 80) type = '物品/地点';
        else if (karmaRoll <= 85) type = '神界注视';
        else if (karmaRoll <= 95) type = '碎片共鸣';
        else type = '无特殊';

        if (type !== '无特殊') {
            const karmaTypes = ['blood', 'grace', 'item', 'fate'];
            const kt = KARNIT.pick(karmaTypes);
            char.karma[kt].push({
                type: type,
                strength: KARNIT.rollRange(10, 50),
                status: '休眠',
                desc: generateKarmaDesc(type)
            });
        }
    }

    generateStats(char);
    generateFamily(char);
    generateStartingMoney(char);

    return char;
}

function generateStats(char) {
    const raceData = DATA.races[char.race];
    const classMultipliers = {
        '赤贫': { min: 3, max: 10, vigConPenalty: KARNIT.roll(3) },
        '平民': { min: 3, max: 12, vigConPenalty: 0 },
        '中产': { min: 5, max: 14, vigConPenalty: 0 },
        '富裕': { min: 8, max: 15, vigConPenalty: 0 },
        '贵族': { min: 10, max: 15, vigConPenalty: 0 },
        '超凡世家': { min: 12, max: 15, vigConPenalty: 0 }
    };

    const mult = classMultipliers[char.familyClass];

    ['VIG','PER','MND','CHA','CON','LUC'].forEach(stat => {
        let base = KARNIT.rollRange(mult.min, mult.max);
        base += (raceData.stats[stat] || 0);
        if ((stat === 'VIG' || stat === 'CON') && mult.vigConPenalty) {
            base -= mult.vigConPenalty;
        }
        char.stats[stat] = KARNIT.clamp(base, 1, 15);
    });

    const talentBonus = Math.floor(DATA.talentTiers.indexOf(char.talentTier) / 2);
    char.stats.MND += talentBonus;
    char.stats.CON += Math.floor(talentBonus / 2);
    char.cultivationSpeed = 100 + (talentBonus * 10);
    char.breakBonus = talentBonus * 2;
}

