        精灵: { base: '上品', stats: { VIG: -1, PER: 2, MND: 1, CHA: 1, CON: -1, LUC: 0 }, desc: '银月森林的长生种，感知与灵识超群。' },
        矮人: { base: '良品', stats: { VIG: 2, PER: 0, MND: -1, CHA: -1, CON: 2, LUC: 0 }, desc: '北山深处的锻造大师，体魄与根骨惊人。' },
