function chooseClass(className) {
    const char = GameState.character;
    char.class = className;

    if (className !== '未选择') {
        const cls = DATA.classes[className];
        Object.keys(cls.bonus).forEach(stat => {
            char.stats[stat] += cls.bonus[stat];
        });
