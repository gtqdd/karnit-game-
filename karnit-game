function advanceAge(years) {
    const char = GameState.character;

    for (let i = 0; i < years; i++) {
        char.ageLived++;
        GameState.turn++;

        const seasons = ['春','夏','秋','冬'];
        GameState.world.season = seasons[GameState.turn % 4];
        if (GameState.turn % 4 === 0) GameState.world.year++;

        // 寿元检查
        const maxAge = char.baseLifespan + char.realmBonus;
        if (char.ageLived >= maxAge) {
            showEnding('寿终正寝');
            return;
        }

        // 碎片饥饿
        if (char.fragment && GameState.turn % 4 === 0) {
            char.hunger += (GameState.config.difficulty === 'III' ? 10 : 5);
            if (char.hunger >= 100) {
                showEnding('源核同化');
                return;
            }
        }

        // 职业侵蚀
        if (char.class !== '未选择') {
            const costTypes = { '法师': '认知污染', '战士': '痛觉钝化', '影刃': '存在稀释', '匠魂': '知识诅咒', '圣音': '信仰债务' };
            if (KARNIT.roll(100) <= 20) {
                char.classCost += KARNIT.rollRange(1, 5);
                if (char.classCost >= 100) {
                    showEnding('法则同化');
                    return;
                }
            }
        }

        // 世界事件
        if (KARNIT.roll(20) === 20) {
            const event = KARNIT.pick(DATA.worldEvents);
            GameState.world.events.push(event);
            addLog(`世界事件：${event}`, 'event');
            GameState.world.epochPulse += 1;
        }

        // 自然衰老（50岁后）
        if (char.ageLived > 50 && char.realm < 4) {
            if (KARNIT.roll(100) <= 10) {
                char.stats.VIG -= 1;
                addLog(`${char.ageLived}岁：岁月侵蚀，体魄下降。`, 'event');
            }
        }

        // 随机遭遇
        if (KARNIT.roll(100) <= 30) {
            const locations = ['城市街道','荒野平原','深山老林','上古遗迹'];
            const loc = KARNIT.pick(locations);
            const encTable = DATA.encounters[loc];
            const enc = weightedPick(encTable, 'weight');
            if (enc.type !== '无事') {
                addLog(`遭遇：在${loc}遇到${enc.desc}。`, 'combat');
            }
        }
    }

    addLog(`度过了${years}年，现在${char.ageLived}岁。`, 'normal');
    showYouth();
}

