function renderStatBar(stat, value, label) {
    const pct = Math.min(100, (value / 15) * 100);
    const tier = value <= 6 ? '低' : value <= 9 ? '中' : value <= 12 ? '高' : value <= 14 ? '巅峰' : '破格';
    const tierClass = value <= 6 ? 'tier-low' : value <= 9 ? 'tier-mid' : value <= 12 ? 'tier-high' : value <= 14 ? 'tier-peak' : 'tier-break';
    return `
        <div class="stat-bar">
            <div class="stat-name">${label}</div>
            <div class="stat-track"><div class="stat-fill ${stat.toLowerCase()}" style="width:${pct}%"></div></div>
            <div class="stat-tier ${tierClass}">${tier}</div>
        </div>
    `;
}

