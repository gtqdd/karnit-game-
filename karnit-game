function combatAction(action) {
    const char = GameState.character;
    const combat = GameState.combat;
    const enemy = combat.enemy;

    combat.round++;

    const realmDiff = enemy.realm - char.realm;

    if (realmDiff >= 3) {
        // 灵魂压制，无法战斗
        combat.playerHp = 0;
        combat.log.push('敌人的威压如山岳般沉重，你甚至连战斗的意志都无法凝聚...');
        showCombatScreen();
        setTimeout(() => showEnding('战斗死亡'), 1500);
        return;
    }

    let playerDmg = 0, enemyDmg = 0;
    let playerRoll = KARNIT.roll(100) + char.stats.VIG + char.stats.MND;
    let enemyRoll = KARNIT.roll(100) + enemy.realm * 10 + enemy.level * 3;

    // 境界压制
    if (realmDiff >= 1) {
        playerRoll -= realmDiff * 30;
    }
    if (char.realm > enemy.realm) {
        enemyRoll -= (char.realm - enemy.realm) * 20;
    }

    switch(action) {
        case 'attack':
            playerDmg = Math.max(5, Math.floor((playerRoll - enemyRoll + 50) / 5));
            enemyDmg = Math.max(5, Math.floor((enemyRoll - playerRoll + 30) / 5));
            combat.log.push(`你发起猛攻，${playerDmg > 20 ? '重创' : playerDmg > 10 ? '击伤' : '擦伤'}了${enemy.name}！`);
            break;
        case 'defend':
            playerDmg = Math.max(0, Math.floor((playerRoll - enemyRoll + 30) / 8));
            enemyDmg = Math.max(0, Math.floor((enemyRoll - playerRoll + 10) / 8));
            combat.log.push(`你稳固防守，${enemyDmg === 0 ? '完全格挡了敌人的攻击！' : '只受了轻伤。'}`);
            break;
        case 'skill':
            playerDmg = Math.max(10, Math.floor((playerRoll - enemyRoll + 80) / 4));
            enemyDmg = Math.max(5, Math.floor((enemyRoll - playerRoll + 40) / 5));
            combat.log.push(`你施展${char.talentElement}系绝技，${playerDmg > 30 ? '差点一击毙敌！' : '造成了可观的伤害。'}`);
            break;
        case 'flee':
            const fleeChance = 50 + (char.stats.PER - enemy.realm * 5);
            if (KARNIT.roll(100) <= fleeChance) {
                addLog(`成功从${enemy.name}手中逃脱！`, 'event');
                showYouth();
                return;
            } else {
                enemyDmg = Math.max(10, Math.floor((enemyRoll - playerRoll + 50) / 4));
                combat.log.push('逃跑失败！敌人追上你并发动了致命一击！');
            }
            break;
    }

    // 碎片特权
    if (char.fragment && KARNIT.roll(100) <= 20) {
        playerDmg = Math.floor(playerDmg * 1.5);
        combat.log[combat.log.length - 1] += ' [源核碎片共鸣增强]';
    }

    enemy.hp -= playerDmg;
    combat.playerHp -= enemyDmg;

    if (enemy.hp <= 0) {
        enemy.hp = 0;
        const rewards = generateCombatRewards(enemy);
        addLog(`击败${enemy.name}！获得${rewards.desc}。`, 'combat');

        // 积累与感悟
        char.accumulation += KARNIT.rollRange(10, 20);
        char.insight += KARNIT.rollRange(1, 5);
        char.vessel += KARNIT.rollRange(1, 3);

        showModal('战斗胜利', `
            <p>${enemy.name}倒在了你的脚下。</p>
            <p>获得：${rewards.desc}</p>
            <p>积累+${KARNIT.rollRange(10,20)}%，感悟+${KARNIT.rollRange(1,5)}</p>
        `, [{ text: '继续', onclick: 'closeModal();showYouth()', class: 'btn' }]);
        return;
    }

    if (combat.playerHp <= 0) {
        combat.playerHp = 0;
        showCombatScreen();
        setTimeout(() => {
            if (char.fragment && KARNIT.roll(100) <= 30) {
                showModal('濒死挣扎', '<p>源核碎片在生死关头爆发出惊人的力量，你勉强保住了性命！</p>', [
                    { text: '继续', onclick: 'closeModal();char.healthStatus="重伤";showYouth()', class: 'btn' }
                ]);
            } else {
                showEnding('战斗死亡');
            }
        }, 1000);
        return;
    }

    showCombatScreen();
}

function generateCombatRewards(enemy) {
    const qualityRoll = KARNIT.roll(100);
    let quality = '普通';
    let desc = '一些铜币和材料';

    if (qualityRoll >= 95) {
        quality = '史诗';
        desc = '星辰铁碎片/高阶法则结晶';
    } else if (qualityRoll >= 85) {
        quality = '稀有';
        desc = '秘银矿石/中级魔兽魔核';
    } else if (qualityRoll >= 60) {
        quality = '普通';
        desc = '精铁装备/常见药材';
    }

    const gold = KARNIT.rollRange(1, 10) * (enemy.realm + 1);
    GameState.character.money.gold += gold;

    return { quality, desc: desc + `, ${gold}金币` };
}

// ==================== 旅行与社交 ====================

function doTravel() {
    const char = GameState.character;
    const destinations = [
        '东舟大陆·大楚帝国', '卡德利亚大陆·银月精灵之森', '卡尼亚大陆·南荒帝国',
        '圣庭洲·神圣教廷', '商贸群岛·碧波核心', '亡者之屿·暗夜王国'
    ].filter(d => !d.includes(char.continent));

    const dest = KARNIT.pick(destinations);
    const cost = KARNIT.rollRange(50, 200);

    if (char.money.gold < cost && char.money.purple < Math.ceil(cost/100)) {
        showModal('资金不足', `<p>前往${dest}需要${cost}金币，你的资金不足。</p>`, [
            { text: '返回', onclick: 'closeModal()', class: 'btn-secondary' }
        ]);
        return;
    }

    char.money.gold -= cost;
    char.location = dest;

    // 遭遇
    const encRoll = KARNIT.roll(100);
    let encText = '';
    if (encRoll <= 20) {
        encText = '旅途平安无事，你顺利抵达目的地。';
    } else if (encRoll <= 50) {
        encText = '途中遭遇低级魔兽袭击，但你轻松解决了它们。';
        char.accumulation += 5;
    } else if (encRoll <= 80) {
        encText = '遇到了一支商队，获得了有价值的情报。';
        char.insight += 3;
    } else {
        encText = '遭遇空间乱流/高阶海魔兽，险些丧命！';
        char.healthStatus = '轻伤';
    }

    addLog(`旅行至${dest}。${encText}`, 'event');
    showModal('旅行结束', `<p>${encText}</p><p>花费：${cost}金币</p>`, [
        { text: '继续', onclick: 'closeModal();showYouth()', class: 'btn' }
    ]);
}

function doSocial() {
    const char = GameState.character;
    const npc = KARNIT.pick(DATA.npcPool);

    const attitudes = ['冷漠','好奇','友善','贪婪','敌意'];
    const attitude = KARNIT.pick(attitudes);

    char.contacts.push({
        name: npc.name,
        realm: npc.realm,
        class: npc.class,
        attitude: attitude,
        relation: 0
    });

    addLog(`结识了${npc.name}（${DATA.realms[npc.realm].name}·${npc.class}），对方态度：${attitude}。`, 'event');

    showModal('社交事件', `
        <p>你在${char.region}的酒馆/集市/高塔中遇到了<span class="gold-text">${npc.name}</span>。</p>
        <p>对方是${DATA.realms[npc.realm].name}境的${npc.class}，对你的态度似乎${attitude === '友善' ? '颇为友善' : attitude === '敌意' ? '带着敌意' : '颇为平淡'}。</p>
        <p class="quote">"${generateNPCDialogue(npc, attitude)}"</p>
    `, [{ text: '继续', onclick: 'closeModal();showYouth()', class: 'btn' }]);
}

function generateNPCDialogue(npc, attitude) {
    const dialogues = {
        '冷漠': ['卡尼特不缺少天才，缺的是活下来的天才。','别挡路。','有事快说。'],
        '好奇': ['你的气息...有些不同寻常。','听说过你的传闻，今日一见果然不凡。','有兴趣做个交易吗？'],
        '友善': ['年轻人，我可以教你一些东西。','如果需要帮助，可以来找我。','你的天赋不应该被浪费。'],
        '贪婪': ['我对你身上的某样东西很感兴趣...','听说你最近发了笔横财？','合作如何？利润三七分。'],
        '敌意': ['你杀了我的弟子/朋友！','滚出我的视线。','下次见面，就是死斗。']
    };
    return KARNIT.pick(dialogues[attitude] || dialogues['冷漠']);
}

function showLog() {
    const logHtml = GameState.log.slice(-20).map(entry => {
        const typeClass = entry.type === 'combat' ? 'log-combat' : entry.type === 'break' ? 'log-break' : entry.type === 'event' ? 'log-event' : entry.type === 'death' ? 'log-death' : 'log-text';
        return `<div class="log-entry"><span class="log-time">${entry.time}</span> <span class="${typeClass}">${entry.text}</span></div>`;
    }).join('');

    showModal('事件日志', `<div class="log-container">${logHtml || '<p>暂无记录。</p>'}</div>`, [
        { text: '关闭', onclick: 'closeModal()', class: 'btn-secondary' }
    ]);
}

// ==================== 终局系统 ====================

function showEnding(type) {
    GameState.phase = 'ending';
    const char = GameState.character;

    const endings = {
        '寿终正寝': {
            title: '寿终正寝',
            desc: '时间是最公平的法则。你的寿元池终于枯竭，在${char.region}的某个宁静夜晚，你闭上了双眼。',
            color: '#5c4d3a'
        },
        '战斗死亡': {
            title: '战死沙场',
            desc: '你的最后一战轰轰烈烈。敌人倒下时，你也倒在了血泊中。卡尼特记得勇者的名字。',
            color: '#8b0000'
        },
        '源核同化': {
            title: '源核同化',
            desc: '饥饿度达到极限，源核碎片彻底吞噬了你的意识。你成为了法则的一部分，一个行走的法则傀儡。',
            color: '#1a0f2e'
        },
        '法则同化': {
            title: '法则同化',
            desc: '职业侵蚀达到极限，你失去了自由意志，化为${char.class === '法师' ? '人形法则编译器' : char.class === '战士' ? '战斗本能的化身' : char.class === '影刃' ? '因果层面的幽灵' : '纯粹的知识容器'}。',
            color: '#4a3f35'
        }
    };

    const ending = endings[type] || endings['寿终正寝'];

    // 计算传说值
    const legend = Math.floor(char.realm * 10 + char.accumulation / 10 + char.contacts.length * 5);

    const html = `
        <div class="parchment ending-screen">
            <h2 style="color:${ending.color}">${ending.title}</h2>
            <div class="divider"></div>
            <div class="narrative" style="text-align:center;text-indent:0;">
                <p>${ending.desc}</p>
                <p class="quote">${char.name} · ${char.race} · ${char.ageLived}岁 · ${DATA.realms[char.realm].name}境</p>
            </div>
            <div class="divider"></div>
            <h3 style="color:var(--accent-bronze);margin-bottom:15px;">【一生回顾】</h3>
            <div class="legacy-stats">
                <div class="legacy-item">
                    <div class="number">${char.ageLived}</div>
                    <div class="label">享年</div>
                </div>
                <div class="legacy-item">
                    <div class="number">${DATA.realms[char.realm].name}</div>
                    <div class="label">最高境界</div>
                </div>
                <div class="legacy-item">
                    <div class="number">${legend}</div>
                    <div class="label">传说值</div>
                </div>
                <div class="legacy-item">
                    <div class="number">${char.contacts.length}</div>
                    <div class="label">结识人数</div>
                </div>
                <div class="legacy-item">
                    <div class="number">${GameState.turn}</div>
                    <div class="label">经历回合</div>
                </div>
                <div class="legacy-item">
                    <div class="number">${char.money.purple}</div>
                    <div class="label">遗留紫金币</div>
                </div>
            </div>
            <div class="divider"></div>
            <div style="margin-top:20px;">
                <button class="btn" onclick="showStartup()">返回主菜单</button>
                <button class="btn btn-secondary" onclick="startGame()">重新开始</button>
                <button class="btn btn-danger" onclick="clearAndRestart()">清除存档</button>
            </div>
        </div>
    `;
    renderScreen(html);
}

function clearAndRestart() {
    GameState.clearSave();
    showStartup();
}

// ==================== 存档系统 ====================

function loadGame() {
    if (GameState.load()) {
        addLog('存档读取成功。', 'event');
        if (GameState.phase === 'startup') showStartup();
        else if (GameState.phase === 'birth') showBirthNarrative();
        else if (GameState.phase === 'ending') showEnding('寿终正寝');
        else showYouth();
    } else {
        showModal('读取失败', '<p>没有找到本地存档。</p>', [
            { text: '确定', onclick: 'closeModal()', class: 'btn-secondary' }
        ]);
    }
}

// ==================== 启动 ====================

window.onload = function() {
    if (GameState.load()) {
        showModal('发现存档', '<p>检测到你之前的人生记录，是否继续？</p>', [
            { text: '继续人生', onclick: 'closeModal();if(GameState.phase==="ending")showStartup();else showYouth()', class: 'btn' },
            { text: '新的开始', onclick: 'closeModal();GameState.clearSave();showStartup()', class: 'btn-secondary' }
        ]);
    } else {
        showStartup();
    }
};
</script>
</body>
</html>
