        breakBonus: 0,
        specialBody: '无',

        stats: { VIG: 0, PER: 0, MND: 0, CHA: 0, CON: 0, LUC: 0 },

        class: '未选择',
        classCost: 0,
        anchors: [],

        money: { copper: 0, silver: 0, gold: 0, purple: 0, crystal: 0 },
