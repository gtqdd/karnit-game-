function doCombat() {
    const char = GameState.character;

    // 生成敌人
    const enemyRealm = Math.max(0, char.realm + KARNIT.rollRange(-2, 3));
    const enemyLevel = KARNIT.rollRange(1, 5);
    const enemyClass = KARNIT.pick(['法师','战士','影刃','魔兽']);
    const enemyName = generateEnemyName(enemyClass);

    const enemy = {
        name: enemyName,
        realm: enemyRealm,
        level: enemyLevel,
        class: enemyClass,
        hp: 100,
        maxHp: 100
    };

    GameState.combat = {
        playerHp: 100,
        playerMaxHp: 100,
        enemy: enemy,
        round: 0,
        log: []
    };

    showCombatScreen();
}

function generateEnemyName(cls) {
    const prefixes = ['狂暴','暗影','腐化','嗜血','冰霜','烈焰'];
    const suffixes = {
        '法师': ['术士','巫师','元素使','咒法师'],
        '战士': ['剑士','狂战士','骑士','佣兵'],
        '影刃': ['刺客','潜行者','暗影','毒刃'],
        '魔兽': ['狼','熊','蟒','鹰','蛛','蝎']
    };
    if (cls === '魔兽') {
        return KARNIT.pick(prefixes) + KARNIT.pick(suffixes[cls]);
    }
    return KARNIT.pick(prefixes) + '·' + KARNIT.pick(suffixes[cls]);
}

