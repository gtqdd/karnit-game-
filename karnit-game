<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>卡尼特人生模拟器 · 源核运转协议 v3.1</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700;900&display=swap');

        :root {
            --parchment: #f5f0e1;
            --parchment-dark: #e8dcc8;
            --ink: #2c2416;
            --ink-light: #5c4d3a;
            --accent-gold: #b8860b;
            --accent-bronze: #8b6914;
            --accent-crimson: #8b0000;
            --accent-void: #1a0f2e;
            --border: #c4b49a;
            --shadow: rgba(44, 36, 22, 0.15);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Noto Serif SC', serif;
            background: linear-gradient(135deg, #1a1510 0%, #2c2416 50%, #1a1510 100%);
            color: var(--ink);
            min-height: 100vh;
            overflow-x: hidden;
        }

        .game-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
        }

        .parchment {
            background: linear-gradient(180deg, var(--parchment) 0%, var(--parchment-dark) 100%);
            border: 3px solid var(--border);
            border-radius: 4px;
            box-shadow: 0 0 20px var(--shadow), inset 0 0 60px rgba(139, 105, 20, 0.05);
            position: relative;
            padding: 30px;
            margin-bottom: 20px;
        }

        .parchment::before {
            content: '';
            position: absolute;
            top: 8px; left: 8px; right: 8px; bottom: 8px;
            border: 1px solid var(--border);
            border-radius: 2px;
            pointer-events: none;
            opacity: 0.6;
        }

        .title-block {
            text-align: center;
            border-bottom: 2px solid var(--accent-gold);
            padding-bottom: 20px;
            margin-bottom: 25px;
            position: relative;
        }

        .title-block h1 {
            font-size: 1.8em;
            font-weight: 900;
            color: var(--ink);
            letter-spacing: 4px;
        }

        .title-block .subtitle {
            font-size: 0.85em;
            color: var(--ink-light);
            margin-top: 8px;
            font-style: italic;
        }

        .cert-num {
            position: absolute;
            top: -10px;
            right: 0;
            font-size: 0.7em;
            color: var(--accent-crimson);
            font-family: monospace;
            background: rgba(139, 0, 0, 0.05);
            padding: 2px 8px;
            border: 1px solid var(--accent-crimson);
            border-radius: 3px;
        }

        .divider {
            border: none;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent-bronze), transparent);
            margin: 20px 0;
            position: relative;
        }

        .divider::after {
            content: '◆';
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            color: var(--accent-bronze);
            background: var(--parchment);
            padding: 0 10px;
            font-size: 0.8em;
        }

        .btn {
            display: inline-block;
            padding: 12px 24px;
            background: linear-gradient(180deg, var(--accent-gold), var(--accent-bronze));
            color: var(--parchment);
            border: 2px solid var(--accent-bronze);
            border-radius: 4px;
            cursor: pointer;
            font-family: 'Noto Serif SC', serif;
            font-size: 1em;
            font-weight: 600;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
            margin: 5px;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.3);
            filter: brightness(1.1);
        }

        .btn-secondary {
            background: linear-gradient(180deg, #6b5b4f, #4a3f35);
            border-color: #4a3f35;
        }

        .btn-danger {
            background: linear-gradient(180deg, #8b0000, #5c0000);
            border-color: #5c0000;
        }

        .btn-void {
            background: linear-gradient(180deg, #2d1f3d, var(--accent-void));
            border-color: #4a3060;
        }

        .choice-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
            margin-top: 20px;
        }

        .choice-btn {
            text-align: left;
            padding: 15px 20px;
            background: linear-gradient(135deg, rgba(184, 134, 11, 0.08), rgba(139, 105, 20, 0.05));
            border: 2px solid var(--border);
            border-radius: 4px;
            cursor: pointer;
            font-family: 'Noto Serif SC', serif;
            font-size: 0.95em;
            color: var(--ink);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .choice-btn::before {
            content: '▸';
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--accent-gold);
            font-weight: bold;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .choice-btn:hover {
            border-color: var(--accent-gold);
            background: linear-gradient(135deg, rgba(184, 134, 11, 0.15), rgba(139, 105, 20, 0.1));
            padding-left: 35px;
        }

        .choice-btn:hover::before { opacity: 1; }

        .choice-btn .choice-title {
            font-weight: 700;
            display: block;
            margin-bottom: 4px;
            color: var(--ink);
        }

        .choice-btn .choice-desc {
            font-size: 0.85em;
            color: var(--ink-light);
            display: block;
        }

        .narrative {
            line-height: 2;
            font-size: 1.05em;
            text-align: justify;
            color: var(--ink);
            text-indent: 2em;
        }

        .narrative p { margin-bottom: 1em; }

        .narrative .quote {
            font-style: italic;
            color: var(--ink-light);
            border-left: 3px solid var(--accent-gold);
            padding-left: 15px;
            margin: 15px 0;
            text-indent: 0;
        }

        .panel-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 15px;
        }

        .panel-section {
            background: rgba(255,255,255,0.3);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 15px;
        }

        .panel-section.full-width { grid-column: 1 / -1; }

        .panel-section h3 {
            font-size: 0.9em;
            color: var(--accent-bronze);
            border-bottom: 1px solid var(--border);
            padding-bottom: 8px;
            margin-bottom: 10px;
            letter-spacing: 2px;
        }

        .panel-row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 0.9em;
            border-bottom: 1px dashed rgba(196, 180, 154, 0.3);
        }

        .panel-row:last-child { border-bottom: none; }

        .panel-label { color: var(--ink-light); }
        .panel-value { font-weight: 600; color: var(--ink); }
        .panel-value.highlight { color: var(--accent-crimson); }
        .panel-value.gold { color: var(--accent-gold); }

        .stat-bar {
            display: flex;
            align-items: center;
            margin: 6px 0;
        }

        .stat-name {
            width: 60px;
            font-size: 0.85em;
            color: var(--ink-light);
        }

        .stat-track {
            flex: 1;
            height: 8px;
            background: rgba(0,0,0,0.08);
            border-radius: 4px;
            overflow: hidden;
            margin: 0 10px;
        }

        .stat-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.5s ease;
        }

        .stat-fill.vig { background: linear-gradient(90deg, #8b0000, #cd5c5c); }
        .stat-fill.per { background: linear-gradient(90deg, #006400, #228b22); }
        .stat-fill.mnd { background: linear-gradient(90deg, #00008b, #4169e1); }
        .stat-fill.cha { background: linear-gradient(90deg, #8b008b, #da70d6); }
        .stat-fill.con { background: linear-gradient(90deg, #8b4513, #d2691e); }
        .stat-fill.luc { background: linear-gradient(90deg, #b8860b, #ffd700); }

        .stat-tier {
            width: 50px;
            text-align: right;
            font-size: 0.8em;
            font-weight: 700;
        }

        .tier-low { color: #8b4513; }
        .tier-mid { color: #2f4f4f; }
        .tier-high { color: #006400; }
        .tier-peak { color: #00008b; }
        .tier-break { color: #8b0000; }

        .hidden-panel {
            background: linear-gradient(135deg, rgba(26, 15, 46, 0.05), rgba(26, 15, 46, 0.1));
            border: 1px dashed var(--accent-void);
            border-radius: 4px;
            padding: 15px;
            margin-top: 15px;
        }

        .hidden-panel h4 {
            color: var(--accent-void);
            font-size: 0.85em;
            margin-bottom: 10px;
            letter-spacing: 2px;
        }

        .log-container {
            max-height: 300px;
            overflow-y: auto;
            padding: 10px;
            background: rgba(0,0,0,0.03);
            border-radius: 4px;
            font-size: 0.9em;
            line-height: 1.8;
        }

        .log-entry {
            padding: 8px 0;
            border-bottom: 1px dashed rgba(0,0,0,0.1);
        }

        .log-entry:last-child { border-bottom: none; }

        .log-time {
            color: var(--accent-bronze);
            font-size: 0.8em;
            font-family: monospace;
        }

        .log-text { color: var(--ink); }
        .log-combat { color: #8b0000; }
        .log-break { color: #006400; }
        .log-event { color: #00008b; }
        .log-death { color: #4a0000; font-weight: bold; }

        .startup-screen {
            text-align: center;
            padding: 40px 20px;
        }

        .startup-screen h1 {
            font-size: 2.2em;
            margin-bottom: 10px;
            letter-spacing: 6px;
        }

        .startup-screen .epigraph {
            font-style: italic;
            color: var(--ink-light);
            margin: 20px 0;
            line-height: 2;
            font-size: 1.1em;
        }

        .config-section {
            text-align: left;
            margin: 20px 0;
            padding: 20px;
            background: rgba(255,255,255,0.2);
            border-radius: 4px;
        }

        .config-section h3 {
            color: var(--accent-bronze);
            margin-bottom: 15px;
            font-size: 1em;
        }

        .config-option {
            display: flex;
            align-items: center;
            padding: 10px;
            margin: 8px 0;
            border: 2px solid var(--border);
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .config-option:hover, .config-option.selected {
            border-color: var(--accent-gold);
            background: rgba(184, 134, 11, 0.08);
        }

        .config-option input { margin-right: 12px; }

        .config-option label {
            flex: 1;
            cursor: pointer;
            font-weight: 600;
        }

        .config-option .config-desc {
            font-size: 0.85em;
            color: var(--ink-light);
            margin-top: 4px;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .fade-in {
            animation: fadeIn 0.6s ease forwards;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .pulse { animation: pulse 2s infinite; }

        .ending-screen {
            text-align: center;
            padding: 40px;
        }

        .ending-screen h2 {
            font-size: 2em;
            color: var(--accent-crimson);
            margin-bottom: 20px;
        }

        .legacy-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin: 20px 0;
        }

        .legacy-item {
            background: rgba(255,255,255,0.3);
            padding: 15px;
            border-radius: 4px;
            border: 1px solid var(--border);
        }

        .legacy-item .number {
            font-size: 1.8em;
            font-weight: 900;
            color: var(--accent-gold);
        }

        .legacy-item .label {
            font-size: 0.85em;
            color: var(--ink-light);
            margin-top: 5px;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--parchment-dark);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--accent-bronze);
            border-radius: 4px;
        }

        @media (max-width: 600px) {
            .panel-grid { grid-template-columns: 1fr; }
            .legacy-stats { grid-template-columns: 1fr; }
            .title-block h1 { font-size: 1.4em; }
        }

        .void-text {
            color: var(--accent-void);
            text-shadow: 0 0 10px rgba(74, 48, 96, 0.3);
        }

        .gold-text {
            color: var(--accent-gold);
            text-shadow: 0 0 8px rgba(184, 134, 11, 0.3);
        }

        .crimson-text { color: var(--accent-crimson); }

        .status-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 0.75em;
            font-weight: 700;
            margin-left: 8px;
        }

        .badge-healthy { background: rgba(0, 100, 0, 0.15); color: #006400; }
        .badge-wounded { background: rgba(139, 0, 0, 0.15); color: #8b0000; }
        .badge-critical { background: rgba(139, 0, 0, 0.3); color: #4a0000; }
        .badge-fragment { background: rgba(26, 15, 46, 0.15); color: var(--accent-void); }

        .combat-arena {
            background: linear-gradient(180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.1));
            border: 2px solid var(--accent-crimson);
            border-radius: 4px;
            padding: 20px;
            margin: 15px 0;
        }

        .combatants {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .combatant {
            text-align: center;
            flex: 1;
        }

        .combatant-name {
            font-weight: 700;
            font-size: 1.1em;
            margin-bottom: 8px;
        }

        .hp-bar {
            width: 100%;
            height: 12px;
            background: rgba(0,0,0,0.1);
            border-radius: 6px;
            overflow: hidden;
            position: relative;
        }

        .hp-fill {
            height: 100%;
            background: linear-gradient(90deg, #228b22, #32cd32);
            transition: width 0.5s ease;
        }

        .hp-fill.warning { background: linear-gradient(90deg, #b8860b, #daa520); }
        .hp-fill.danger { background: linear-gradient(90deg, #8b0000, #dc143c); }

        .hp-text {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 0.7em;
            line-height: 12px;
            color: white;
            text-shadow: 1px 1px 1px rgba(0,0,0,0.5);
        }

        .vs-mark {
            font-size: 1.5em;
            font-weight: 900;
            color: var(--accent-crimson);
            margin: 0 20px;
        }

        .combat-log {
            font-style: italic;
            color: var(--ink-light);
            text-align: center;
            padding: 10px;
            background: rgba(0,0,0,0.03);
            border-radius: 4px;
            margin-top: 10px;
        }

        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        .modal-content {
            background: var(--parchment);
            border: 3px solid var(--accent-gold);
            border-radius: 4px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

        .modal-title {
            font-size: 1.3em;
            color: var(--accent-crimson);
            margin-bottom: 15px;
            text-align: center;
        }

        .modal-body {
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .modal-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .input-field {
            width: 100%;
            padding: 10px;
            border: 2px solid var(--border);
            border-radius: 4px;
            font-family: 'Noto Serif SC', serif;
            font-size: 1em;
            background: rgba(255,255,255,0.5);
            margin: 5px 0;
        }

        .input-field:focus {
            outline: none;
            border-color: var(--accent-gold);
        }

        .save-slot {
            border: 2px solid var(--border);
            border-radius: 4px;
            padding: 15px;
            margin: 10px 0;
            cursor: pointer;
            transition: all 0.3s;
        }

        .save-slot:hover {
            border-color: var(--accent-gold);
            background: rgba(184, 134, 11, 0.05);
        }

        .save-slot .save-title {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .save-slot .save-info {
            font-size: 0.85em;
            color: var(--ink-light);
        }
    </style>
</head>
<body>
    <div class="game-container" id="gameRoot"></div>

    <div class="modal-overlay" id="modalOverlay">
        <div class="modal-content" id="modalContent"></div>
    </div>

<script>
// ==================== 核心引擎 ====================

const KARNIT = {
    version: '3.1',
    epoch: 2960001,

    roll: (sides) => Math.floor(Math.random() * sides) + 1,
    rollRange: (min, max) => Math.floor(Math.random() * (max - min + 1)) + min,
    clamp: (val, min, max) => Math.max(min, Math.min(max, val)),
    pick: (arr) => arr[Math.floor(Math.random() * arr.length)],

    certCounter: 0,
    generateCert: function() {
        this.certCounter++;
        return `KARNIT-${Date.now().toString(36).toUpperCase()}-${String(this.certCounter).padStart(3, '0')}`;
    }
};

// ==================== 数据表 ====================

