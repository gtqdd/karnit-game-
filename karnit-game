// ==================== 时间推进与事件 ====================

function advanceTime(years) {
    const char = GameState.character;

    for (let i = 0; i < years; i++) {
        char.ageLived++;
        GameState.turn++;

        // 季节轮转
        const seasons = ['春','夏','秋','冬'];
        GameState.world.season = seasons[GameState.turn % 4];
        if (GameState.turn % 4 === 0) GameState.world.year++;

        // 生存检定（赤贫）
        if (char.familyClass === '赤贫' && KARNIT.roll(100) <= 5) {
            const crises = ['疾病','饥荒','战乱波及','家庭破碎'];
            const crisis = KARNIT.pick(crises);
            char.healthStatus = '疾病缠身';
            char.stats.VIG -= 1;
            addLog(`${char.ageLived}岁：遭遇${crisis}，体魄受损。`, 'event');
        }

        // 元素亲和显现（8岁）
        if (char.ageLived === 8) {
            const chance = DATA.talentTiers.indexOf(char.talentTier) * 10;
            if (KARNIT.roll(100) <= chance) {
                addLog(`${char.ageLived}岁：元素亲和显现！你对${char.talentElement}元素的感知变得敏锐。`, 'break');
                char.stats.MND += 1;
            }
        }

        // 天赋测试（12岁）
        if (char.ageLived === 12) {
            addLog(`${char.ageLived}岁：天赋测试塔检测。测试官评价："${getTalentComment(char.talentTier)}"`, 'break');
            showTalentTest();
            return;
        }

        // 碎片饥饿
        if (char.fragment && char.ageLived % 4 === 0) {
            char.hunger += 5;
            if (char.hunger >= 50) {
                addLog(`源核饥饿度上升至${char.hunger}，梦境开始出现低语。`, 'event');
            }
        }

        // 世界事件（每年暗骰）
        if (KARNIT.roll(20) === 20) {
            const event = KARNIT.pick(DATA.worldEvents);
            GameState.world.events.push(event);
            addLog(`世界事件：${event}`, 'event');
            GameState.world.epochPulse += 1;
        }
    }

    if (char.ageLived < 12) {
        showChildhood();
    } else if (char.ageLived < 16) {
        showYouth();
    } else {
        showAdult();
    }
}

